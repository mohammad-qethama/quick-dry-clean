---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { text } from '../i18n/utils';
const t = text('ar');
---
<BaseLayout lang="ar" notFound><Header lang="ar"/><main id="main" class="section container not-found"><p class="eyebrow" dir="ltr">404</p><h1>{t.notFoundTitle}</h1><p>{t.notFoundText}</p><a class="button" href="/">{t.home}</a></main><Footer lang="ar"/></BaseLayout>

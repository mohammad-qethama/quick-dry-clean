---
import { text, type Lang } from '../i18n/utils';
import { site } from '../config/site';
import Icon from './Icon.astro';
interface Props { lang: Lang }
const t = text(Astro.props.lang);
---
<section id="about" class="section container split-layout"><figure class="shop-photo"><img src={site.placeholders.images.shop} alt={t.shopAlt} width="900" height="700" loading="lazy"/><figcaption class="caption"><bdi>{t.sampleShop}</bdi></figcaption></figure><div><p class="eyebrow">{t.aboutKicker}</p><h2>{t.aboutTitle}</h2><p><bdi>{t.story}</bdi></p><ul class="trust-points">{t.trustPoints.map(point => <li><Icon name="check"/>{point}</li>)}</ul></div></section>
